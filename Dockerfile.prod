## Stage 1 — build
FROM rust:1.90-alpine AS builder
WORKDIR /app

# musl-dev: C bindings; openssl-*: static OpenSSL (no runtime dep); g++: cityhash-sys C++
RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static g++ binutils pkgconf

# Static-link OpenSSL so the runtime image needs none of it
ENV OPENSSL_STATIC=1

# Cache dependencies before copying source
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release
RUN rm -rf src

# Build the real binary
COPY src ./src
RUN touch src/main.rs && cargo build --release

# Strip debug info
RUN strip --strip-all /app/target/release/app

## Stage 2 — minimal runtime
FROM alpine:3

RUN apk add --no-cache ca-certificates

COPY --from=builder /app/target/release/app /app.bin

# Run as non-root
RUN addgroup -S nonroot && adduser -S -G nonroot nonroot
USER nonroot:nonroot

ENTRYPOINT ["/app.bin"]
